   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🚀 Fine-Tuning Backlink Hunter AI Model in Google Colab\n",
    "\n",
    "This notebook fine-tunes Llama-3-8B using **Unsloth (QLoRA)** for custom SEO Auditing and Outreach Email Generation.\n",
    "\n",
    "### Step 1: Ensure T4 GPU is Enabled\n",
    "Go to `Runtime` -> `Change runtime type` -> select `T4 GPU`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Install Unsloth and Dependencies\n",
    "!pip install --no-deps \"unsloth[colab-new] @ git+https://github.com/unslothai/unsloth.git\"\n",
    "!pip install --no-deps xformers trl peft accelerate bitsandbytes datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Create Fine-Tuning Dataset (dataset.jsonl)\n",
    "import json\n",
    "\n",
    "dataset_samples = [\n",
    "    {\n",
    "        \"instruction\": \"Analyze webpage metadata and body text to generate an SEO audit report.\",\n",
    "        \"input\": \"Title: Tech Startup | Meta Description: None | Word Count: 180\",\n",
    "        \"output\": json.dumps({\n",
    "            \"seo_errors\": [\n",
    "                {\"issue\": \"Missing Meta Description\", \"severity\": \"high\", \"explanation\": \"Lacks meta description tag.\", \"fix_recommendation\": \"Add a 150-char meta tag.\", \"toxic_sites\": []},\n",
    "                {\"issue\": \"Toxic Referring Subnets\", \"severity\": \"high\", \"explanation\": \"5 toxic spam domains detected.\", \"fix_recommendation\": \"Submit disavow.txt to GSC.\", \"toxic_sites\": [\"spam-link.xyz\", \"pbn-99.net\"]}\n",
    "            ]\
        }, indent=2)\n",
    "    },\n",
    "    {\n",
    "        \"instruction\": \"Draft a personalized guest post outreach pitch email.\",\n",
    "        \"input\": \"Target Domain: techcrunch.com | Topic: Next.js 15 & AI Agents\",\n",
    "        \"output\": \"Hi TechCrunch Editor,\\n\\nI loved your recent article on AI automation. I wrote a technical breakdown on Next.js 15 for AI agents.\\n\\nWould you be open to reviewing a draft?\\n\\nBest,\\nAuthor\"\n",
    "    }\n",
    "]\n",
    "\n",
    "with open(\"dataset.jsonl\", \"w\", encoding=\"utf-8\") as f:\n",
    "    for sample in dataset_samples:\n",
    "        f.write(json.dumps(sample) + \"\\n\")\n",
    "\n",
    "print(\"✅ dataset.jsonl generated!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Load Base Llama-3-8B Model with Unsloth\n",
    "from unsloth import FastLanguageModel\n",
    "import torch\n",
    "\n",
    "max_seq_length = 2048\n",
    "model, tokenizer = FastLanguageModel.from_pretrained(\n",
    "    model_name=\"unsloth/llama-3-8b-Instruct-bnb-4bit\",\n",
    "    max_seq_length=max_seq_length,\n",
    "    load_in_4bit=True,\n",
    ")\n",
    "\n",
    "# Apply LoRA adapters\n",
    "model = FastLanguageModel.get_peft_model(\n",
    "    model,\n",
    "    r=16,\n",
    "    target_modules=[\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\", \"gate_proj\", \"up_proj\", \"down_proj\"],\n",
    "    lora_alpha=16,\n",
    "    lora_dropout=0,\n",
    "    bias=\"none\",\n",
    "    use_gradient_checkpointing=\"unsloth\",\n",
    ")\n",
    "\n",
    "print(\"✅ Llama 3 model & LoRA adapters initialized!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Prepare Dataset & Train Model\n",
    "from datasets import load_dataset\n",
    "from trl import SFTTrainer\n",
    "from transformers import TrainingArguments\n",
    "\n",
    "dataset = load_dataset(\"json\", data_files={\"train\": \"dataset.jsonl\"})\n",
    "\n",
    "def formatting_prompts_func(examples):\n",
    "    instructions = examples[\"instruction\"]\n",
    "    inputs = examples[\"input\"]\n",
    "    outputs = examples[\"output\"]\n",
    "    texts = []\n",
    "    for inst, inp, out in zip(instructions, inputs, outputs):\n",
    "        text = f\"### Instruction:\\n{inst}\\n\\n### Input:\\n{inp}\\n\\n### Response:\\n{out}\"\n",
    "        texts.append(text)\n",
    "    return {\"text\": texts}\n",
    "\n",
    "dataset = dataset.map(formatting_prompts_func, batched=True)\n",
    "\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    tokenizer=tokenizer,\n",
    "    train_dataset=dataset[\"train\"],\n",
    "    dataset_text_field=\"text\",\n",
    "    max_seq_length=max_seq_length,\n",
    "    dataset_num_proc=2,\n",
    "    packing=False,\n",
    "    args=TrainingArguments(\n",
    "        per_device_train_batch_size=2,\n",
    "        gradient_accumulation_steps=4,\n",
    "        warmup_steps=5,\n",
    "        max_steps=60,\n",
    "        learning_rate=2e-4,\n",
    "        fp16=not torch.cuda.is_bf16_supported(),\n",
    "        bf16=torch.cuda.is_bf16_supported(),\n",
    "        logging_steps=1,\n",
    "        optim=\"adamw_8bit\",\n",
    "        seed=3407,\n",
    "        output_dir=\"outputs\",\n",
    "    ),\n",
    ")\n",
    "\n",
    "trainer_stats = trainer.train()\n",
    "print(\"🎉 Fine-Tuning Complete! Stats:\", trainer_stats)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 6: Save Model & Export\n",
    "model.save_pretrained_merged(\"fine_tuned_seo_model\", tokenizer, save_method=\"merged_16bit\")\n",
    "print(\"✅ Fine-tuned model saved to fine_tuned_seo_model!\")"
   ]
  }
 ],
